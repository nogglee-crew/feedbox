# FEEDBOX runtime database (Supabase Transaction pooler / port 6543 권장)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Prisma migration 전용 direct connection
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# Supabase Auth + Storage
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# 레거시 Supabase 키 이름도 지원
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Google OAuth callback URL:
# https://YOUR_SUPABASE_PROJECT.supabase.co/auth/v1/callback
# Supabase redirect allow list:
# https://YOUR_FEEDBOX_DOMAIN/auth/callback

# 대시보드 접근 허용 이메일. 비우면 로그인한 모든 계정 허용.
DASHBOARD_ALLOWED_EMAILS=

# /demo에서 사용할 실제 FEEDBOX 프로젝트 키
NEXT_PUBLIC_DEMO_PROJECT_KEY=
NEXT_PUBLIC_DEMO_API_KEY=

# 배포 도메인 (OG 절대 URL, sitemap, robots에 사용)
NEXT_PUBLIC_SITE_URL=https://feedbox.nogglee.com

# GA4 측정 ID (G-XXXXXXXXXX). 배포 환경에만 설정한다.
# 로컬에서는 비워두면 gtag를 로드하지 않아 실측 데이터가 오염되지 않는다.
NEXT_PUBLIC_GA_ID=
