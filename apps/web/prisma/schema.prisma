generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  MEMBER
}

enum Plan {
  FREE
  PRO
}

enum BillingStatus {
  UNPAID
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AccessOverride {
  NONE
  ADMIN
  TEST
}

enum ReleaseStatus {
  OPEN
  CLOSED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  DONE
  CLOSED
}

model Organization {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String           @unique
  plan                  Plan             @default(FREE)
  billingStatus         BillingStatus    @default(UNPAID) @map("billing_status")
  accessOverride        AccessOverride   @default(NONE) @map("access_override")
  billingProvider       String?          @map("billing_provider")
  billingCustomerId     String?          @unique @map("billing_customer_id")
  billingSubscriptionId String?          @unique @map("billing_subscription_id")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  members               OrganizationMember[]
  projects              Project[]
  subscriptionInterests SubscriptionInterest[]

  @@map("organizations")
}

model OrganizationMember {
  id         String           @id @default(uuid()) @db.Uuid
  orgId      String           @map("org_id") @db.Uuid
  authUserId String?          @map("auth_user_id") @db.Uuid
  email      String
  // Null until an invited member signs in with Google.
  name       String?
  avatarUrl  String?          @map("avatar_url")
  /// 체인지로그 마지막 확인 시각. 최신 항목 날짜와 비교해 미확인 뱃지를 만든다
  changelogSeenAt DateTime?   @map("changelog_seen_at") @db.Timestamptz(6)
  role       OrganizationRole @default(MEMBER)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([email])
  @@index([authUserId])
  @@map("organization_members")
}

model Project {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @map("org_id") @db.Uuid
  name       String
  projectKey String       @unique @map("project_key")
  apiKey     String       @map("api_key")
  baseUrl    String?      @map("base_url")
  /// 프로젝트 단위 이슈 번호 채번기. 원자적 증가로 동시 등록 시 중복을 막는다
  issueSeq   Int          @default(0) @map("issue_seq")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  releases   Release[]
  sessions   QaSession[]
  issues     Issue[]

  @@index([orgId, createdAt])
  @@map("projects")
}

model Release {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @map("project_id") @db.Uuid
  version   String
  status    ReleaseStatus @default(OPEN)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions  QaSession[]
  issues    Issue[]

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@map("releases")
}

model QaSession {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  projectId String    @map("project_id") @db.Uuid
  releaseId String    @map("release_id") @db.Uuid
  createdBy String?   @map("created_by")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  release   Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@index([releaseId, createdAt])
  @@map("qa_sessions")
}

model Issue {
  id             Int         @id @default(autoincrement())
  /// 화면에 노출하는 프로젝트 단위 일련번호.
  /// id는 전역 증가라 그대로 보여주면 다른 고객사의 유입량까지 드러난다
  number         Int
  projectId      String      @map("project_id") @db.Uuid
  releaseId      String      @map("release_id") @db.Uuid
  sessionId      String?     @map("session_id") @db.Uuid
  pageUrl        String      @map("page_url")
  selector       String
  elementText    String?     @map("element_text")
  viewportWidth  Int?        @map("viewport_width")
  viewportHeight Int?        @map("viewport_height")
  browser        String?
  errorName      String?     @map("error_name")
  errorCode      String?     @map("error_code")
  errorMessage   String?     @map("error_message")
  errorStack     String?     @map("error_stack")
  apiMethod      String?     @map("api_method")
  apiUrl         String?     @map("api_url")
  apiStatus      Int?        @map("api_status")
  memo           String
  screenshotUrl  String?     @map("screenshot_url")
  status         IssueStatus @default(OPEN)
  assignee       String?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  release        Release     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  session        QaSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  comments       IssueComment[]

  @@unique([projectId, number])
  @@index([releaseId, status, createdAt])
  @@map("issues")
}

/// 이슈 코멘트. 플랫 구조(대댓글 없음).
/// 멤버 코멘트는 작성 시점 프로필을 스냅샷하고, 익명 코멘트는 guestKey로만 식별한다.
/// 화면의 "테스터 A/B" 라벨은 세션 안에서 guestKey의 첫 코멘트 순서로 읽기 시점에 파생한다.
model IssueComment {
  id              Int      @id @default(autoincrement())
  issueId         Int      @map("issue_id")
  /// 익명 테스터의 브라우저 식별 키(localStorage). 멤버 코멘트는 null.
  /// 본인 수정/삭제 판정에 쓴다 — 키가 유실되면 권한도 사라지는 best-effort 권한
  guestKey        String?  @map("guest_key")
  /// 멤버 작성자의 auth user id. 본인 수정/삭제 판정용. 익명 코멘트는 null
  authorUserId    String?  @map("author_user_id") @db.Uuid
  /// 조직 멤버 작성자 프로필 스냅샷. 익명 코멘트는 null
  authorName      String?  @map("author_name")
  authorAvatarUrl String?  @map("author_avatar_url")
  body            String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  issue           Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@map("issue_comments")
}

model SubscriptionInterest {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  orgId           String?       @map("org_id") @db.Uuid
  privacyAgreedAt DateTime      @map("privacy_agreed_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  org             Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@map("subscription_interests")
}

/// 제품 내부 행동 계측. orgId/authUserId는 관계를 걸지 않는다.
/// 조직이나 회원이 삭제돼도 이탈 분석에 필요한 이력이 남아야 한다.
model AnalyticsEvent {
  id         BigInt   @id @default(autoincrement())
  name       String
  anonId     String   @map("anon_id")
  sessionId  String   @map("session_id")
  authUserId String?  @map("auth_user_id") @db.Uuid
  orgId      String?  @map("org_id") @db.Uuid
  path       String?
  referrer   String?
  country    String?
  params     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([name, createdAt])
  @@index([orgId, createdAt])
  @@index([authUserId, createdAt])
  @@map("analytics_events")
}
